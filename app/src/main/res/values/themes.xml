<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The real theme lives in Compose. This exists to paint the window paper
         before composition so cold start does not flash white. -->
    <style name="Theme.VisionLauncher" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
